{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectDedicatedBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::replace-with-your-bucket"
    },
    {
      "Sid": "SaveAndReadSiteBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::replace-with-your-bucket/sites/example-site/*"
    },
    {
      "Sid": "RemoveConnectionTestOnly",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::replace-with-your-bucket/sites/example-site/ozeki-database-backup-for-s3-connection-test-*"
    }
  ]
}
